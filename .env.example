# --- NEAR ---
NEAR_NETWORK_ID=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org
# Account that calls the MPC contract. It is the "predecessor" in key derivation,
# so it determines every foreign address the agent controls.
NEAR_ACCOUNT_ID=
# Full-access or function-call key for NEAR_ACCOUNT_ID (ed25519:...)
NEAR_PRIVATE_KEY=

# --- NEAR Chain Signatures (MPC) ---
MPC_CONTRACT_ID=v1.signer-prod.testnet
# Root secp256k1 key of the MPC network (64-byte uncompressed x||y, base58).
# Verify with: view v1.signer-prod.testnet public_key {}
MPC_ROOT_PUBLIC_KEY=secp256k1:4NfTiv3UsGahebgTaHyD9vF8KYKMBnfd6kh94mK6xv8fGBiJB8TBtFMP5WWXz6B89Ac1fbpzPwAvoyQebemHFwx3
# Deposit attached to each `sign` call, in NEAR
MPC_SIGN_DEPOSIT_NEAR=0.05

# --- EVM ---
# rpc.sepolia.org is unresponsive; any Sepolia RPC (Alchemy/Infura/publicnode) works
ETHEREUM_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC=https://sepolia.base.org

# --- Agent policy guardrails (enforced BEFORE any MPC call) ---
POLICY_MAX_PER_TX_ETH=0.01
# Rolling 24h cap, per chain
POLICY_DAILY_CAP_ETH=0.05
# true = only POLICY_ALLOWLIST destinations may receive funds or calls
POLICY_STRICT_MODE=false
# Comma-separated 0x addresses
POLICY_ALLOWLIST=
POLICY_DENYLIST=
# Emergency kill switch: true halts all agent signing
GHOSTSIGN_FROZEN=false

# --- Hosted deployment (Railway) ---
# Setting HOST to a non-loopback address (Railway does this automatically) enables PUBLIC mode:
# access code required for every action, strict allowlist forced, caps default to 0.001/0.01 ETH.
# HOST=0.0.0.0
# GHOSTSIGN_ACCESS_CODE=choose-a-long-random-code
