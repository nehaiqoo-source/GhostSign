{
  "name": "ghostsign",
  "version": "0.1.0",
  "description": "Autonomous AI agent execution layer using NEAR Chain Signatures (MPC) to sign foreign-chain transactions",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:server && npm run dashboard:build",
    "dev": "tsx src/index.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.dev.json",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "demo": "tsx scripts/demo-agent.ts",
    "api": "tsx src/server/index.ts",
    "dashboard:dev": "vite --config dashboard/vite.config.ts",
    "dashboard:build": "vite build --config dashboard/vite.config.ts",
    "dashboard:typecheck": "tsc -p dashboard/tsconfig.json",
    "dev:all": "concurrently -k -n api,ui -c green,cyan \"npm:api\" \"npm:dashboard:dev\"",
    "dashboard": "npm run dashboard:build && npm run api",
    "build:all": "npm run build",
    "cli": "node dist/index.js",
    "build:server": "tsc -p tsconfig.json"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "bs58": "^6.0.0",
    "dotenv": "^18.0.9",
    "elliptic": "^6.6.1",
    "ethers": "^6.17.0",
    "js-sha3": "^0.13.0",
    "near-api-js": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/bs58": "^4.0.4",
    "@types/elliptic": "^6.4.18",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
