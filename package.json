  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.dev.json",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "demo": "tsx scripts/demo-agent.ts"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "bs58": "^6.0.0",
    "dotenv": "^18.0.9",
    "elliptic": "^6.6.1",
    "ethers": "^6.17.0",
    "js-sha3": "^0.13.0",
    "near-api-js": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/elliptic": "^6.4.18",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
